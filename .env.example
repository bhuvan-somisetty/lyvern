# Copy to .env for local runs outside Docker. Never commit .env. No real secrets here.
LYVERN_ENVIRONMENT=dev
LYVERN_LOG_LEVEL=INFO
LYVERN_DATABASE_URL=postgresql+psycopg://lyvern:lyvern@localhost:5433/lyvern
LYVERN_REDIS_URL=redis://localhost:6380/0
# Added in later milestones (GitHub App, LLM providers) are documented here when introduced.
# --- added 2026-11-16 (names only; real values live in your local .env, never committed)
LYVERN_GEMINI_API_KEY=
LYVERN_GROQ_API_KEY=
LYVERN_GITHUB_WEBHOOK_SECRET=
LYVERN_SMEE_URL=
# GitHub App (ids are not secret; the private key file stays outside the repo)
LYVERN_GITHUB_APP_ID=
LYVERN_GITHUB_APP_CLIENT_ID=
LYVERN_GITHUB_APP_PRIVATE_KEY_PATH=
LYVERN_GITHUB_INSTALLATION_ID=
# Comma-separated owner/repo list the bot may WRITE to (reviews/comments). Default: the sandbox only.
LYVERN_WRITE_ALLOWED_REPOS=bhuvan-somisetty/lyvern-sandbox
